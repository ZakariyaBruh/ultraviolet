{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/|icons/|favicon.svg|manifest.webmanifest|sitemap.xml|robots.txt|apple-touch-icon.png).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cloud?sweep=1",
      "schedule": "* * * * *"
    }
  ]
}
