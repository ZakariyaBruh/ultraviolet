{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blogs/sitemap.xml",
      "destination": "/api/blog?sitemap=1"
    },
    {
      "source": "/blogs/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/blogs",
      "destination": "/api/blog"
    },
    {
      "source": "/((?!assets/|api/|icons/|favicon.svg|manifest.webmanifest|sitemap.xml|robots.txt|apple-touch-icon.png).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cloud?sweep=1",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "frictionx.vercel.app"
        }
      ],
      "destination": "https://www.frictionx.app/$1",
      "permanent": true
    }
  ]
}
