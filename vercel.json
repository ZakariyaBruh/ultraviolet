{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/app", "destination": "/focus", "permanent": true }
  ],
  "crons": [
    {
      "path": "/api/cloud?sweep=1",
      "schedule": "* * * * *"
    }
  ]
}
