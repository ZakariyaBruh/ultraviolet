{
  "buildCommand": "node scripts/prepare.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/wisp/(.*)",
      "destination": "/api/wisp?path=$1"
    }
  ],
  "functions": {
    "api/wisp.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(go|wipe).html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://frictionx.vercel.app"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(scram|baremux|libcurl)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
